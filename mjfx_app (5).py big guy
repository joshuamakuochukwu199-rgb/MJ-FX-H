import streamlit as st
import os
from PIL import Image
from google import genai

# Configure MJFX Web App Page Layout and Styling
st.set_page_config(
    page_title="MJFX - Advanced SMC Analyst Bot",
    page_icon="📈",
    layout="wide"
)

# Custom CSS to brand the app as 'MJFX'
st.markdown("""
    <style>
    .main {
        background-color: #0e1117;
        color: #ffffff;
    }
    h1, h2, h3 {
        color: #00ffcc !important;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }
    .stButton>button {
        background-color: #00ffcc;
        color: #0e1117;
        font-weight: bold;
